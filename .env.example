# trajecta deployment environment example.
# Copy to .env for docker compose, then replace production secrets.

# Public host ports exposed by docker compose.
TRAJECTA_HOST_SERVER_PORT=8080
TRAJECTA_HOST_MONITOR_PORT=8081
TRAJECTA_POSTGRES_PORT=5432

# Postgres service and application DSN.
POSTGRES_DB=trajecta
POSTGRES_USER=trajecta
POSTGRES_PASSWORD=change-me-strong-password
TRAJECTA_DATABASE_DSN=postgres://trajecta:change-me-strong-password@postgres:5432/trajecta?sslmode=disable

# Optional first provider bootstrap. Leave empty to start only the Web UI.
TRAJECTA_BOOTSTRAP_UPSTREAM_BASE_URL=
TRAJECTA_BOOTSTRAP_UPSTREAM_API_KEY=

# Optional hosted web_search through the compose searxng profile.
TRAJECTA_RESPONSES_CODEX_COMPAT_ENABLED=true
TRAJECTA_RESPONSES_CODEX_COMPAT_AUTO_INJECT_HOSTED_TOOLS=web_search
TRAJECTA_TOOLS_WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8088/
SEARXNG_INSTANCE_NAME=trajecta-searxng
SEARXNG_PORT=8088

# Replace credentials found in request bodies with reversible, format-preserving
# stand-ins before the request reaches the model provider, and restore them in
# the response. On unless this is set to false. See docs/SECRET_MASKING.md.
TRAJECTA_SECRET_MASKING_ENABLED=true

# Persist the real-to-stand-in pairs in a local bbolt file so a restart or a new
# session reuses the same stand-in. On unless this is set to false.
TRAJECTA_SECRET_MASKING_MAPPING_STORE_ENABLED=true
# TRAJECTA_SECRET_MASKING_MAPPING_STORE_PATH=/path/to/secret_mask_mappings.db
TRAJECTA_SECRET_MASKING_MAPPING_STORE_LOAD_LIMIT=0
